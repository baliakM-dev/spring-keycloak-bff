# === Java / Maven ===
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# === Java / Gradle ===
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# === Spring Boot ===
*.log
application-local.yml
application-local.yaml
application-local.properties

# === Node / React / TypeScript (frontend) ===
node_modules/
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Environment & secrets ===
# Never commit real credentials. Local Keycloak/dev-only values belong in
# an explicitly-labeled dev config, not a loaded .env — see
# .claude/skills/spring-keycloak-bff/references/security-invariants.md
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*credentials*.json

# === Docker ===
docker-compose.override.yml

# === IDE ===
# .idea/ is intentionally not ignored here — it has its own .idea/.gitignore
# managing local-only files (workspace.xml, shelf/, etc.).
.vscode/
*.iws
*.ipr
out/

# === OS ===
.DS_Store
Thumbs.db

# === Logs ===
logs/
*.log

.idea